# Salin ke .env.local dan isi dengan kredensial Supabase (lokal atau cloud).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp HTTP API (WAHA) untuk kirim notifikasi struk dari kasir — opsional.
# Isi WAHA_URL dengan base URL engine WAHA, mis. http://localhost:3002
# (docker run devlikeapro/waha). Tanpa ini, tombol "Kirim WA" memberi pesan
# konfigurasi belum diisi.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
